# Porta HTTP da API
PORT=3333
# Caminho do arquivo SQLite
DATABASE_PATH=./data/nexo.db
# Segredo para assinatura das sessões (mínimo 32 caracteres) — gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Duração da sessão
SESSION_HOURS=12
# Origem permitida do frontend (CORS)
CORS_ORIGIN=http://localhost:5173
# Diretório de backups
BACKUP_DIR=./backups
