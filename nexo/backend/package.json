{
  "name": "nexo-jovem-backend",
  "version": "1.0.0",
  "description": "API do NEXO JOVEM — Secretaria e Tesouraria",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "provisionar-lider": "tsx --disable-warning=ExperimentalWarning scripts/provisionar-lider.ts",
    "seed": "tsx --disable-warning=ExperimentalWarning scripts/seed.ts",
    "backup": "tsx --disable-warning=ExperimentalWarning scripts/backup.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
